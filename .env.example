# Copy to .env.local for local development. Never commit real secrets.

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite database (Postgres compiled
# to WASM, stored in PGLITE_DATA_DIR). Set it to use a real PostgreSQL server.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/modular_furniture
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite

# --- Site / brand (all placeholders; see src/config/site.ts) -----------------
SITE_URL=http://localhost:3000
SITE_NAME=Modular Furniture Studio
SITE_TAGLINE=Furniture built from parts that fit
SITE_CONTACT_EMAIL=
SITE_CONTACT_PHONE=
SITE_SOCIAL_INSTAGRAM=
SITE_SOCIAL_PINTEREST=

# While true: a "sample content" notice is shown site-wide and search engines
# are told not to index the site. Set to false only when the catalog is real.
CATALOG_IS_SAMPLE=true
